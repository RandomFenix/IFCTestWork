<Window x:Class="IFCTestWork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IFCTestWork"
        xmlns:xbim="http://schemas.Xbim.com/Presentation"
        xmlns:vm="clr-namespace:IFCTestWork.ViewModels"
        xmlns:models="clr-namespace:IFCTestWork.Models"
        xmlns:helix="http://helix-toolkit.org/wpf"
        mc:Ignorable="d"
        Title="Просмотр IFC" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Border BorderBrush="Black" BorderThickness="5" CornerRadius="10">
        <DockPanel>
            <ToolBarTray DockPanel.Dock="Top" Background="#F3F3F3">
                <ToolBar Padding="5">
                    <Button Name="BtnOpenFile" Command="{Binding OpenCommand}" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Открыть файл" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </ToolBar>
            </ToolBarTray>
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180" MinWidth="180"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="12">
                    <Grid>
                        <GroupBox Grid.Column="0" Header="Иерархия Ifc" Margin="5">
                            <TreeView x:Name="IfcTree" ItemsSource="{Binding Nodes}" SelectedItemChanged="IfcTree_SelectedItemChanged">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <EventSetter Event="Selected" Handler="TreeItem_Selected"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Blue"/>
                                    <HierarchicalDataTemplate DataType="{x:Type models:NodeItem}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </GroupBox>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              ShowsPreview="True"/>

                <Border Grid.Column="2" Background="#202124">
                    <helix:HelixViewport3D x:Name="viewport"
                           ModelUpDirection="0,0,1"
                           ZoomExtentsWhenLoaded="True"
                           MouseLeftButtonDown="Viewport_PreviewMouseLeftButtonDown">
                        <helix:DefaultLights/>
                        <ModelVisual3D Content="{Binding Model3D}"/>
                    </helix:HelixViewport3D>
                </Border>

                    <GridSplitter Grid.Column="3"
                                  Width="5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  ShowsPreview="True"/>

                <Border Grid.Column="4" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3">
                    <DataGrid ItemsSource="{Binding Properties}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Атрибут" Binding="{Binding Parameter}" Width="100"/>
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
